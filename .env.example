# Environment variables template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES

# Database
DATABASE_URL=sqlite:///farmart.db

# JWT Secret - change this in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT Token Expiry (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600

# Flask
FLASK_APP=app.py
FLASK_ENV=development

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# M-Pesa Configuration (Daraja API)
# Get these from your M-Pesa Developer Portal
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey

# B2C Credentials (for Farmer Payouts)
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_security_credential

# Base URL for Webhook Callbacks
# Use ngrok URL for development: https://xxxx.ngrok-free.app
BASE_URL=http://127.0.0.1:5000
